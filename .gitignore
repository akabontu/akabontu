# .gitignore for CV. Magz Group Website
# Created on January 28, 2026

# Logs
logs/
*.log
php_errors.log
access.log

# Environment files
.env
.env.local
.env.production

# Database files
*.sql
*.sqlite
*.db

# Upload directories
uploads/
temp/
cache/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node modules (if any)
node_modules/

# Composer
vendor/

# Temporary files
tmp/
temp/

# Backup files
*.bak
*.backup
*.old

# Configuration files with sensitive data
config.php
connection.php
database.php
settings.php

# Admin sensitive files
admin/config/
admin/logs/

# Error pages (keep in repo but don't modify accidentally)
# webpage/error/404.php
# webpage/error/403.php
# webpage/error/500.php